.game-page { min-height: 100vh; padding: 48rpx 40rpx 80rpx; box-sizing: border-box; color: #111827; background: #f7f9fc; }
.game-header { display: flex; flex-direction: column; gap: 16rpx; margin-bottom: 32rpx; }
.eyebrow { color: #2563eb; font-size: 20rpx; font-weight: 700; letter-spacing: 2rpx; }
.title { font-size: 56rpx; font-weight: 800; }
.copy, .goal { color: #475569; font-size: 28rpx; line-height: 1.5; }
.progress-card, .card-panel { padding: 28rpx; margin-bottom: 24rpx; background: #fff; border: 1rpx solid #0f172a18; border-radius: 20rpx; }
.progress { display: block; margin-bottom: 8rpx; color: #2563eb; font-size: 52rpx; font-weight: 800; }
.actions { display: grid; gap: 16rpx; }
.star { padding: 24rpx; color: #111827; background: #fff; border: 1rpx solid #0f172a18; border-radius: 16rpx; text-align: left; }
.star[disabled] { color: #2563eb; background: #eff6ff; }
.card-panel { display: flex; flex-direction: column; gap: 16rpx; }
.card-panel button, .primary-btn, .secondary-btn { margin-top: 16rpx; color: #fff; background: #2563eb; border-radius: 14rpx; }
.secondary-btn { color: #2563eb; background: #eff6ff; }
.primary-btn { margin-top: 32rpx; }
