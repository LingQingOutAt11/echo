{
  "expo": {
    "name": "回声",
    "slug": "echo",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "scheme": "echo",
    "plugins": [
      "expo-dev-client",
      "expo-notifications",
      ["react-native-nfc-manager", { "nfcPermission": "用 NFC 标签进入对应的线下破冰活动。" }],
      ["react-native-ble-manager", { "isBleRequired": false, "neverForLocation": true, "bluetoothAlwaysPermission": "用于发现附近正在等待破冰的手机。" }]
    ],
    "ios": {
      "bundleIdentifier": "com.echo.app",
      "buildNumber": "1",
      "supportsTablet": true,
      "infoPlist": {
        "NFCReaderUsageDescription": "用 NFC 标签进入对应的线下破冰活动。",
        "NSBluetoothAlwaysUsageDescription": "用于发现附近正在等待破冰的手机。",
        "NSBluetoothPeripheralUsageDescription": "用于让附近的手机发现破冰入口。",
        "UIBackgroundModes": ["bluetooth-central", "bluetooth-peripheral"]
      }
    },
    "android": {
      "package": "com.echo.app",
      "versionCode": 1,
      "permissions": ["NFC", "POST_NOTIFICATIONS", "BLUETOOTH_SCAN", "BLUETOOTH_CONNECT", "BLUETOOTH_ADVERTISE", "ACCESS_FINE_LOCATION"],
      "adaptiveIcon": {
        "backgroundColor": "#0B1426",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": { "favicon": "./assets/favicon.png" }
  }
}
